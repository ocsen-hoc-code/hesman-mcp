{
  "name": "hesman-mcp",
  "version": "0.1.0",
  "description": "Next-generation MCP server for deep code intelligence",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hesman": "./dist/index.js"
  },
  "files": [
    "dist/",
    "parsers/*.wasm"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "download:parsers": "tsx scripts/download-parsers.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@xenova/transformers": "^2.17.2",
    "@zvec/zvec": "^0.5.0",
    "better-sqlite3": "^11.8.0",
    "picomatch": "^4.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.0",
    "web-tree-sitter": "^0.22.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
