{
  "name": "hesman-mcp",
  "version": "1.0.0",
  "description": "Next-gen MCP server for deep code intelligence — 98% token reduction",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hesman": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "code-intelligence",
    "semantic-search",
    "tree-sitter",
    "ai-agent",
    "impact-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocsen-hoc-code/hesman-mcp.git"
  },
  "license": "MIT",
  "author": "Minh Do",
  "files": [
    "dist/",
    "parsers/*.wasm",
    "queries/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "homepage": "https://github.com/ocsen-hoc-code/hesman-mcp#readme",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest bench --run",
    "test:perf:ci": "vitest bench --run",
    "test:e2e": "vitest run tests/e2e/ --reporter=verbose --testTimeout=120000",
    "prepublishOnly": "npm test && npm run typecheck && npm run lint && npm run build",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "download:parsers": "tsx scripts/download-parsers.ts",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@xenova/transformers": "^2.17.2",
    "@zvec/zvec": "^0.5.0",
    "better-sqlite3": "^11.8.0",
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.0",
    "web-tree-sitter": "0.25.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
